"""
Auth directive to protect queries and mutations
Requires rank: 1=User, 2=PowerUser, 3=Admin
"""
directive @auth(rank: Int = 1) on FIELD_DEFINITION

type User {
    ID:ID!
    name:String
}
input NewUser{
    name:String!
}
type Mutation {
    createUser(input:NewUser):User
}
type Query {
    getUsers:[User!]
}